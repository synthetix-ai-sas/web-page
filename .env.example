# Resend (https://resend.com) — used by /api/contact to send contact-form submissions.
RESEND_API_KEY=

# Must be an address on a domain verified in your Resend account
# (e.g. contacto@synthetixaisas.com), not a free/unverified inbox.
CONTACT_FROM_EMAIL=

# Where submissions land. Defaults to contact@synthetixaisas.com if unset.
CONTACT_TO_EMAIL=contact@synthetixaisas.com
