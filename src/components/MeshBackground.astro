---
// Decorative neural-mesh node field, per brand rule: clean lines + nodes,
// never a literal brain silhouette.
interface Props { class?: string }
const { class: className = '' } = Astro.props;
---
<svg class:list={['mesh-bg', className]} viewBox="0 0 1200 500" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <defs>
    <pattern id="sx-grid" width="42" height="42" patternUnits="userSpaceOnUse">
      <path d="M 42 0 L 0 0 0 42" fill="none" stroke="rgba(0,210,255,0.08)" stroke-width="1"/>
    </pattern>
  </defs>
  <rect width="1200" height="500" fill="url(#sx-grid)" />
  <g stroke="rgba(0,82,212,0.35)" stroke-width="1">
    <line x1="150" y1="110" x2="420" y2="70" />
    <line x1="420" y1="70" x2="620" y2="160" />
    <line x1="620" y1="160" x2="880" y2="90" />
    <line x1="300" y1="260" x2="620" y2="160" />
  </g>
  <g fill="var(--sx-tech-cyan)">
    <circle cx="150" cy="110" r="4" />
    <circle cx="620" cy="160" r="5" />
    <circle cx="300" cy="260" r="3" />
  </g>
  <g fill="var(--sx-electric-blue)">
    <circle cx="420" cy="70" r="4" />
    <circle cx="880" cy="90" r="4" />
  </g>
</svg>
