---
import mark from '../assets/logo-mark.png';
import { useTranslations, localizePath, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const year = new Date().getFullYear();

const socialLinks = [
  {
    label: 'Facebook',
    href: 'https://web.facebook.com/synthetixai',
    icon: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-7.5H16l.5-3h-3V8.5c0-.9.3-1.5 1.6-1.5H16.5V4.2C16 4.1 15 4 13.9 4 11.6 4 10 5.4 10 8v2.5H7.5v3H10V21h3.5z"/></svg>',
  },
  {
    label: 'Instagram',
    href: 'https://www.instagram.com/synthetix_ai_sas',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"/></svg>',
  },
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/company/synthetix-ai-sas',
    icon: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.5 4.78 5.76V21h-4v-5.6c0-1.34-.02-3.06-1.87-3.06-1.87 0-2.16 1.46-2.16 2.96V21H9z"/></svg>',
  },
  {
    label: 'TikTok',
    href: 'https://www.tiktok.com/@synthetix_ai_sas',
    icon: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M14 3h2.2c.2 1.5 1.1 2.9 2.6 3.6.6.3 1.3.5 2 .5v2.6c-1.5 0-2.9-.4-4.1-1.2v6.4c0 3.2-2.6 5.7-5.7 5.7S5.3 18.1 5.3 15c0-3.1 2.4-5.5 5.4-5.7v2.7c-1.5.2-2.7 1.5-2.7 3 0 1.7 1.4 3 3 3s3-1.3 3-3V3z"/></svg>',
  },
];
---
<footer class="sx-footer">
  <div class="container sx-footer__grid">
    <div class="sx-footer__brand">
      <div class="sx-footer__logo">
        <img src={mark.src} alt="" width="35" height="32" />
        <span>Synthetix<b>AI</b></span>
      </div>
      <p>{t('footer.tagline')}</p>
      <div class="sx-footer__social">
        {socialLinks.map((s) => (
          <a href={s.href} aria-label={s.label} target="_blank" rel="noopener noreferrer" set:html={s.icon} />
        ))}
      </div>
    </div>

    <div class="sx-footer__col">
      <h4>{t('footer.col.services')}</h4>
      <a href={localizePath('/servicios#desarrollo', lang)}>{t('nav.services.dev')}</a>
      <a href={localizePath('/servicios#agentes', lang)}>{t('nav.services.agents')}</a>
      <a href={localizePath('/servicios#consultoria', lang)}>{t('nav.services.consulting')}</a>
      <a href={localizePath('/servicios', lang)}>{t('footer.services.all')}</a>
      <a href={localizePath('/productos', lang)}>{t('nav.products')}</a>
    </div>

    <div class="sx-footer__col">
      <h4>{t('footer.col.company')}</h4>
      <a href={localizePath('/nosotros', lang)}>{t('nav.about')}</a>
      <a href={localizePath('/blog', lang)}>{t('nav.blog')}</a>
      <a href={localizePath('/nosotros#faq', lang)}>{t('nav.about.faq')}</a>
    </div>

    <div class="sx-footer__col">
      <h4>{t('footer.col.contact')}</h4>
      <p class="sx-footer__hours">{t('footer.hours')}<br/>{t('footer.hours.value')}</p>
      <a href="mailto:contact@synthetixaisas.com">contact@synthetixaisas.com</a>
      <a href={localizePath('/contacto', lang)}>{t('footer.cta')}</a>
    </div>
  </div>

  <div class="container sx-footer__legal">
    <span>© {year} {t('footer.rights')}</span>
    <div class="sx-footer__legal-links">
      <a href={localizePath('/privacidad', lang)}>{t('footer.privacy')}</a>
      <a href={localizePath('/terminos', lang)}>{t('footer.terms')}</a>
    </div>
  </div>
</footer>

<style>
  .sx-footer {
    background: var(--sx-deep-shadow);
    border-top: 1px solid var(--sx-slate-800);
    padding-top: var(--sx-space-24);
  }
  .sx-footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: var(--sx-space-12);
    padding-bottom: var(--sx-space-16);
  }
  .sx-footer__logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 20px;
    color: #fff;
  }
  .sx-footer__logo b { color: var(--sx-tech-cyan); }
  .sx-footer__brand p { margin-top: var(--sx-space-3); max-width: 320px; }
  .sx-footer__social { display: flex; gap: var(--sx-space-3); margin-top: var(--sx-space-4); }
  .sx-footer__social a {
    width: 32px; height: 32px;
    display: flex; align-items: center; justify-content: center;
    border: 1px solid var(--sx-slate-700);
    border-radius: var(--sx-radius-md);
    color: var(--sx-slate-300);
  }
  .sx-footer__social a :global(svg) { width: 16px; height: 16px; }
  .sx-footer__social a:hover { border-color: var(--sx-tech-cyan); color: var(--sx-tech-cyan); }

  .sx-footer__col h4 { font-size: var(--fs-sm); text-transform: uppercase; letter-spacing: 0.08em; color: var(--sx-slate-400); margin-bottom: var(--sx-space-4); }
  .sx-footer__col a { display: block; color: var(--sx-slate-200); font-size: var(--fs-sm); margin-bottom: var(--sx-space-3); }
  .sx-footer__col a:hover { color: var(--sx-tech-cyan); }
  .sx-footer__hours { color: var(--sx-slate-400); font-size: var(--fs-sm); }

  .sx-footer__legal {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--sx-space-6) 0;
    border-top: 1px solid var(--sx-slate-800);
    font-size: var(--fs-xs);
    color: var(--sx-slate-500);
  }
  .sx-footer__legal-links { display: flex; gap: var(--sx-space-6); }
  .sx-footer__legal-links a:hover { color: var(--sx-tech-cyan); }

  @media (max-width: 900px) {
    .sx-footer__grid { grid-template-columns: 1fr 1fr; }
    .sx-footer__legal { flex-direction: column; gap: var(--sx-space-3); text-align: center; }
  }
  @media (max-width: 560px) {
    .sx-footer__grid { grid-template-columns: 1fr; }
  }
</style>
