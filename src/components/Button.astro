---
interface Props {
  href?: string;
  variant?: 'primary' | 'ghost' | 'outline';
  size?: 'md' | 'sm';
  class?: string;
}
const { href, variant = 'primary', size = 'md', class: className = '' } = Astro.props;
const Tag = href ? 'a' : 'button';
---
<Tag
  href={href}
  class:list={['sx-btn', `sx-btn--${variant}`, `sx-btn--${size}`, className]}
>
  <slot />
</Tag>

<style>
  .sx-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--sx-space-2);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--fs-sm);
    border-radius: var(--sx-radius-md);
    padding: 12px 22px;
    /* inset box-shadow instead of a real border: a transparent border on an
       element nested under the Navbar's backdrop-filter blur renders as a
       faint bright seam in Chrome (same root cause fixed via box-shadow on
       .sx-nav in Navbar.astro). box-shadow isn't affected by that bug. */
    box-shadow: inset 0 0 0 1px transparent;
    cursor: pointer;
    transition: transform var(--sx-duration-fast) var(--sx-ease-standard),
                background var(--sx-duration-base) var(--sx-ease-standard),
                box-shadow var(--sx-duration-base) var(--sx-ease-standard);
  }
  .sx-btn:active { transform: translateY(1px); }
  .sx-btn:focus-visible { box-shadow: var(--sx-glow-cyan); }

  .sx-btn--primary {
    background: var(--sx-gradient-cyan);
    color: #04121F;
  }
  .sx-btn--primary:hover { box-shadow: var(--sx-glow-blue); }

  .sx-btn--outline {
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--sx-slate-600);
    color: var(--sx-slate-100);
  }
  .sx-btn--outline:hover { box-shadow: inset 0 0 0 1px var(--sx-tech-cyan); color: var(--sx-tech-cyan); }

  .sx-btn--ghost {
    background: rgba(255, 255, 255, 0.04);
    color: var(--sx-slate-100);
  }
  .sx-btn--ghost:hover { background: rgba(255, 255, 255, 0.08); }

  .sx-btn--sm { padding: 8px 16px; font-size: var(--fs-xs); }
</style>
