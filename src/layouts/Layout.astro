---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { useTranslations, switchLangPath, localizePath, type Lang } from '../i18n/utils';
import logoLockup from '../assets/logo-lockup.png';

interface Props {
  title: string;
  lang: Lang;
  description?: string;
  /** Path (or absolute URL) to the Open Graph / Twitter card image. Defaults
   * to the site-wide 1200x630 interim OG image. */
  ogImage?: string;
}
const { title, lang, ogImage = '/og-image.png' } = Astro.props;
const t = useTranslations(lang);
const description = Astro.props.description ?? t('footer.tagline');

const currentPath = Astro.url.pathname;
const esHref = new URL(switchLangPath(currentPath, 'es'), Astro.site).toString();
const enHref = new URL(switchLangPath(currentPath, 'en'), Astro.site).toString();
const canonicalHref = lang === 'es' ? esHref : enHref;
const ogLocale = { es: 'es_ES', en: 'en_US' } as const satisfies Record<Lang, string>;

const fullTitle = `${title} — Synthetix AI`;
// og:image / twitter:image: a stable 1200x630 asset, distinct from the
// Organization.logo below (which stays pointed at the small brand mark).
const ogImageHref = new URL(ogImage, Astro.site).toString();
const organizationLogoHref = new URL(logoLockup.src, Astro.site).toString();

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://www.synthetixaisas.com/#organization',
  name: 'Synthetix AI',
  legalName: 'Synthetix AI S.A.S.',
  taxID: '902069229-9',
  url: 'https://www.synthetixaisas.com',
  logo: organizationLogoHref,
  email: 'contact@synthetixaisas.com',
  telephone: '+57 314 806 7436',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Cra 21B # 55-25',
    addressLocality: 'Manizales',
    addressRegion: 'Caldas',
    addressCountry: 'CO',
  },
};

// BreadcrumbList: derived from the URL path, reusing the same nav/footer
// labels shown elsewhere for each route (see Navbar.astro / ui.ts).
const breadcrumbLabelKeys: Partial<Record<string, Parameters<typeof t>[0]>> = {
  servicios: 'nav.services',
  industrias: 'nav.industries',
  nosotros: 'nav.about',
  carreras: 'nav.careers',
  'casos-de-exito': 'nav.cases',
  contacto: 'footer.col.contact',
  privacidad: 'footer.privacy',
  terminos: 'footer.terms',
};
// Segment keys below are Spanish (the canonical slugs), so resolve the
// current page back to its ES path first — as of H-1 the EN path segment
// is a different, translated slug and can no longer be recovered by just
// stripping the `/en` prefix.
const localPath = switchLangPath(currentPath, 'es');
const pathSegments = localPath.split('/').filter(Boolean);
const breadcrumbItems = [
  {
    '@type': 'ListItem',
    position: 1,
    name: t('nav.home'),
    item: new URL(localizePath('/', lang), Astro.site).toString(),
  },
  ...pathSegments
    .map((segment, index) => {
      const key = breadcrumbLabelKeys[segment];
      if (!key) return null;
      const segmentPath = `/${pathSegments.slice(0, index + 1).join('/')}`;
      return {
        '@type': 'ListItem',
        position: index + 2,
        name: t(key),
        item: new URL(localizePath(segmentPath, lang), Astro.site).toString(),
      };
    })
    .filter((item): item is NonNullable<typeof item> => item !== null),
];
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems,
};

// Language banner: suggests the other locale when the browser language
// doesn't match the page being viewed. Never navigates on its own — see the
// script below. Symmetric: ES pages suggest EN and vice versa.
const otherLang: Lang = lang === 'es' ? 'en' : 'es';
const tOther = useTranslations(otherLang);
const langBannerHref = switchLangPath(currentPath, otherLang);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>

    <link rel="canonical" href={canonicalHref} />
    <link rel="alternate" hreflang="es" href={esHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="x-default" href={esHref} />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:locale:alternate" content={ogLocale[lang === 'es' ? 'en' : 'es']} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Synthetix AI" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:image" content={ogImageHref} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t('meta.ogImageAlt')} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageHref} />

    <!-- Design-system type families: Montserrat (display), Poppins (body/UI), JetBrains Mono (code/data) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&family=JetBrains+Mono:wght@500;600&family=Montserrat:wght@800&display=swap"
      rel="stylesheet"
    />

    <ClientRouter />
    <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  </head>
  <body>
    <div id="sx-lang-banner" class="sx-lang-banner" data-target-lang={otherLang} hidden>
      <div class="container sx-lang-banner__inner">
        <p>{tOther('langBanner.message')}</p>
        <div class="sx-lang-banner__actions">
          <a href={langBannerHref} id="sx-lang-banner-switch" class="sx-lang-banner__switch">{tOther('langBanner.switch')}</a>
          <button
            type="button"
            id="sx-lang-banner-dismiss"
            class="sx-lang-banner__dismiss"
            aria-label={tOther('langBanner.dismiss')}
          >&times;</button>
        </div>
      </div>
    </div>
    <Navbar lang={lang} />
    <main id="main-content" transition:animate="fade">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      // Scroll-reveal for elements marked [data-reveal], per motion spec:
      // fade + translateY, no bounce, 320ms.
      function initReveal() {
        const els = document.querySelectorAll('[data-reveal]');
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15 }
        );
        els.forEach((el) => io.observe(el));
      }
      document.addEventListener('astro:page-load', initReveal);
    </script>

    <script>
      // Language banner: never navigates on its own (no location.replace,
      // .assign, or .href assignment reachable from browserLang). It only
      // toggles the [hidden] attribute on a plain <a href> banner rendered
      // above the Navbar — see the markup and switchLangPath() call in this
      // file's frontmatter. Replaces the old silent auto-redirect, which
      // fired against every Spanish page render for crawlers reporting
      // en-US (Google's WRS), risking the English DOM getting indexed under
      // Spanish URLs.
      import { getStoredLang, setStoredLang, browserLang } from '../i18n/detect';

      function initLangBanner() {
        const banner = document.getElementById('sx-lang-banner');
        if (!(banner instanceof HTMLElement)) return;
        const targetLang = banner.dataset.targetLang;
        const switchLink = document.getElementById('sx-lang-banner-switch');
        const dismissBtn = document.getElementById('sx-lang-banner-dismiss');

        if (getStoredLang() || browserLang() !== targetLang) {
          banner.hidden = true;
          return;
        }
        banner.hidden = false;

        dismissBtn?.addEventListener('click', () => {
          const currentLang = window.location.pathname.startsWith('/en') ? 'en' : 'es';
          setStoredLang(currentLang);
          banner.hidden = true;
        });

        switchLink?.addEventListener('click', () => {
          if (targetLang === 'es' || targetLang === 'en') setStoredLang(targetLang);
          // No preventDefault/navigation call here — this is a real <a href>
          // click, left to the browser (and ClientRouter) to handle normally.
        });
      }
      document.addEventListener('astro:page-load', initLangBanner);
    </script>
  </body>
</html>

<style is:global>
  [data-reveal] {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity var(--sx-duration-slow) var(--sx-ease-out),
                transform var(--sx-duration-slow) var(--sx-ease-out);
  }
  [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<style>
  .sx-lang-banner {
    background: var(--sx-slate-800);
    border-bottom: 1px solid var(--sx-slate-700);
  }
  .sx-lang-banner__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sx-space-3);
    padding: var(--sx-space-2) var(--sx-space-6);
    font-size: var(--fs-sm);
  }
  .sx-lang-banner__inner p {
    margin: 0;
    color: var(--sx-slate-200);
  }
  .sx-lang-banner__actions {
    display: flex;
    align-items: center;
    gap: var(--sx-space-4);
  }
  .sx-lang-banner__switch {
    color: var(--sx-tech-cyan);
    font-weight: 600;
  }
  .sx-lang-banner__switch:hover {
    text-decoration: underline;
  }
  .sx-lang-banner__dismiss {
    background: none;
    border: none;
    color: var(--sx-slate-400);
    font-size: var(--fs-body);
    line-height: 1;
    cursor: pointer;
    padding: var(--sx-space-1);
  }
  .sx-lang-banner__dismiss:hover {
    color: var(--sx-slate-100);
  }
</style>
